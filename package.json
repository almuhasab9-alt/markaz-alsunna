{
  "name": "webapp",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run tailwind:css && vite build",
    "tailwind:css": "tailwindcss -i src/tailwind.css -o public/static/tailwind.css --minify",
    "preview": "wrangler pages dev",
    "deploy": "npm run build && wrangler pages deploy",
    "dev:sandbox": "wrangler pages dev dist --d1=webapp-production --local --ip 0.0.0.0 --port 3000",
    "db:migrate:local": "wrangler d1 migrations apply webapp-production --local",
    "db:migrate:remote": "wrangler d1 migrations apply webapp-production --remote",
    "create-admin": "node scripts/create-admin.mjs",
    "db:seed": "wrangler d1 execute webapp-production --local --file=./seed.sql",
    "db:reset": "rm -rf .wrangler/state/v3/d1 && npm run db:migrate:local && npm run db:seed",
    "db:console:local": "wrangler d1 execute webapp-production --local",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "hono": "^4.12.33"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "wrangler": "^4.110.0"
  }
}
